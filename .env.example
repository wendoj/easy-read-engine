# Copy to .env and fill in. Never commit .env.

# Amazon Bedrock (primary, paid per token). A long-term Bedrock API key from
# the Bedrock console. Calls stay in AWS_REGION: no cross-Region inference
# profile is used, so letter text stays in London.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=eu-west-2

# Groq (fallback, free tier)
GROQ_API_KEY=

# Ordered provider:model chains per role, comma-separated. Tried in order.
# Providers: bedrock, groq. A 429, 5xx, 401, 403, 404, timeout or network
# error moves to the next entry.
MODEL_REWRITE=bedrock:openai.gpt-oss-120b-1:0,groq:openai/gpt-oss-120b
MODEL_JUDGE=bedrock:qwen.qwen3-235b-a22b-2507-v1:0,groq:qwen/qwen3.8-27b
MODEL_VISION=bedrock:qwen.qwen3-vl-235b-a22b,groq:qwen/qwen3.8-27b

# Checker service base URL (http://checker:8000 inside Docker Compose)
CHECKER_URL=http://localhost:8000

# Pictogram PNG cache (ARASAAC images only, never letter content). Relative
# paths resolve from the web app's working directory. Defaults to symbol-cache
# (gitignored). In Docker Compose, point it at the symbol-cache volume.
SYMBOL_CACHE_DIR=symbol-cache

# Chromium for PDF export (/api/export). In Docker, the path of the system
# Chromium the web image installs (for example /usr/bin/chromium). Leave empty
# in development to use Chromium or Google Chrome from a standard install path.
CHROMIUM_PATH=
# development | production. Any provider other than bedrock or groq fails start-up.
APP_ENV=development
# Judge access key. Secret: use a random value, for example the output of
# `openssl rand -base64 32`. The routes that call a model (convert, extract,
# check) need it; sample letters and PDF export stay open. Required in
# production: without it, live conversion is closed and only samples work.
# Leave it empty in development to keep every route open. Changing it revokes
# every access cookie. With APP_ENV unset, only `next dev` and Vitest count as
# development for access; `next start` or a container without APP_ENV counts
# as production, so live conversion stays closed until ACCESS_KEY is set.
ACCESS_KEY=
